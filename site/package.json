{
  "$schema": "https://json.schemastore.org/package",
  "name": "@concat-src/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The GitHub Pages site of concat-src: a live catalog of a sample project or of your own folder, in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mark1russell7/quantity": "^0.4.0",
    "@mark1russell7/site-pages": "^0.4.6",
    "concat-src": "workspace:*"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  }
}
